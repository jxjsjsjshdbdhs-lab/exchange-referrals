<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Exchange Referrals</title>

    <script src="https://telegram.org/js/telegram-web-app.js"></script>

    <style>
        * {
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            margin: 0;
            background: #f3f4f6;
            color: #222;
        }

        .container {
            max-width: 500px;
            margin: auto;
            padding: 20px;
        }

        .header {
            text-align: center;
            margin-bottom: 20px;
        }

        .avatar {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            margin-bottom: 10px;
        }

        .card {
            background: white;
            border-radius: 18px;
            padding: 20px;
            margin-bottom: 15px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.08);
        }

        .title {
            font-size: 15px;
            color: #777;
            margin-bottom: 8px;
        }

        .value {
            font-size: 28px;
            font-weight: bold;
        }

        .referral {
            direction: ltr;
            background: #f1f1f1;
            padding: 12px;
            border-radius: 10px;
            word-break: break-all;
            margin-top: 10px;
        }

        button {
            width: 100%;
            border: none;
            padding: 13px;
            border-radius: 12px;
            background: #0088cc;
            color: white;
            font-size: 16px;
            margin-top: 10px;
            cursor: pointer;
        }

        .link-item {
            background: #f5f5f5;
            padding: 12px;
            border-radius: 10px;
            margin-top: 10px;
            direction: ltr;
            word-break: break-all;
        }

        .empty {
            text-align: center;
            color: #888;
            padding: 15px;
        }
    </style>
</head>

<body>

<div class="container">

    <div class="header">

        <img id="avatar"
             class="avatar"
             src="https://telegram.org/img/t_logo.png">

        <h2 id="username">Welcome 👋</h2>

    </div>

    <div class="card">
        <div class="title">⭐ Points</div>
        <div class="value" id="points">0</div>
    </div>

    <div class="card">
        <div class="title">👥 Referrals</div>
        <div class="value" id="referrals">0</div>
    </div>

    <div class="card">

        <div class="title">🔗 Referral Link</div>

        <div class="referral" id="referralLink">
            Loading...
        </div>

        <button onclick="copyReferral()">
            📋 Copy Referral Link
        </button>

    </div>

    <div class="card">

        <div class="title">📋 Links</div>

        <div id="links">
            <div class="empty">
                No links yet
            </div>
        </div>

        <button onclick="addLink()">
            ➕ Add Link
        </button>

    </div>

</div>

<script>

    const tg = window.Telegram.WebApp;

    tg.ready();
    tg.expand();

    const user = tg.initDataUnsafe.user;

    if (user) {

        document.getElementById("username").textContent =
            user.first_name || "User";

        if (user.photo_url) {
            document.getElementById("avatar").src =
                user.photo_url;
        }

        const telegramId = user.id;

        const referralLink =
            "https://t.me/GETREFERRALSsbot?start=" + telegramId;
        document.getElementById("referralLink").textContent =
            referralLink;
    }

    function copyReferral() {

        const link =
            document.getElementById("referralLink").textContent;

        navigator.clipboard.writeText(link);

        tg.showPopup({
            title: "تم النسخ ✅",
            message: "تم نسخ رابط الإحالة",
            buttons: [{type: "ok"}]
        });
    }

    function addLink() {

        tg.showPopup({
            title: "إضافة رابط",
            message: "ميزة إضافة الروابط راح نربطها ب
